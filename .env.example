# Server only. Create a key in Google AI Studio for a project WITHOUT billing.
# Never put this key in VITE_* variables or browser code.
GEMINI_API_KEY=
# Model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback model if primary model reaches quota or rate limits
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# App safeguard, independent of Google's account/project quota.
GEMINI_DAILY_LIMIT=20
GEMINI_MIN_INTERVAL_SECONDS=3
# Optional free data.gov key: https://fdc.nal.usda.gov/api-key-signup
# Blank uses USDA's real DEMO_KEY (30 requests/hour and 50/day per IP).
USDA_API_KEY=
PORT=3001
HOST=0.0.0.0

# Cloud accounts (Supabase Free). Leave ALL blank to retain device-only local use.
# These two are public and included in the browser build. Never use a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only: same project URL and its sb_secret_... key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Production site origin, e.g. https://portion-example.vercel.app (no trailing path).
APP_ORIGIN=

# Optional Claude evaluation. Disabled by default; enabling can incur API costs.
# Do not change production settings until the owner approves cost and privacy terms.
AI_PROVIDER=gemini
CLAUDE_EVALUATION_ENABLED=false
ANTHROPIC_API_KEY=
# Explicit supported model ID from Claude Console; no automatic selection.
ANTHROPIC_MODEL=
# Optional provider-neutral safeguard settings override GEMINI_* limits if set.
AI_DAILY_LIMIT=
AI_MIN_INTERVAL_SECONDS=
